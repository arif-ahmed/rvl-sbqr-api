# =============================================================================
# .env.example — tracked template for the gitignored repo-root `.env`.
#
# Loaded by SBQR.Api in DEVELOPMENT ONLY (Program.cs §1): parsed and layered
# on top of appsettings.json, environment variables and user-secrets — it is
# the single source of truth for local `dotnet run` overrides. NEVER loaded
# in Staging/Production; deployed environments inject the same keys via the
# orchestrator's env-var channel (see README "Where each secret lives").
#
# Keys use the canonical double-underscore env-var form (same vocabulary as
# docker/.env and orchestrator injection). Values are literal — no ${VAR}
# interpolation. `#` starts a comment; one surrounding quote pair is stripped.
#
# Copy to `.env` (repo root) and fill in. NEVER commit real values.
# =============================================================================

# --- PostgreSQL (docker-compose defaults) --------------------------------------
ConnectionStrings__sbqr_app=Host=localhost;Port=5432;Database=sbqr_app;Username=postgres;Password=postgres;Include Error Detail=true
ConnectionStrings__sbqr_key_vault=Host=localhost;Port=5432;Database=sbqr_key_vault;Username=postgres;Password=postgres;Include Error Detail=true

# --- OAuth2 (dev-only disposable values) ----------------------------------------
Jwt__SigningKey=dev-only-signing-key-change-me-0123456789abcdef
Auth__Bootstrap__ClientSecret=dev-only-bootstrap-secret

# --- BB trust store -------------------------------------------------------------
# REQUIRED: the host refuses to start without a TrustStore__BaseUrl. Point it
# at the trust store you test against (e.g. an ephemeral mock you run
# yourself).
TrustStore__BaseUrl=http://localhost:5002
# Dev-only cadence: sync once at boot and every minute. Staging/prod never
# set these.
TrustStore__SyncOnStartup=true
TrustStore__SyncIntervalMinutes=1

# --- Crypto / S3 vault (dev flips the safe base default Local -> S3) ------------
Crypto__VaultProvider=S3

# --- S3 object storage (real AWS bucket — personal, NEVER commit) ----------------
Storage__Region=REPLACE_ME_AWS_REGION
Storage__BucketName=REPLACE_ME_DEV_BUCKET_NAME
Storage__VaultFolder=keycustody
Storage__AccessKeyId=REPLACE_ME_AWS_ACCESS_KEY_ID
Storage__SecretAccessKey=REPLACE_ME_AWS_SECRET_ACCESS_KEY

# --- Optional: personal Argon2id PHC hash (or keep in user-secrets) ---------------
# Generate:  dotnet run --project src/Host/SBQR.Api -- --generate-bootstrap-secret
#Auth__Bootstrap__ClientSecretHash=$argon2id$...
