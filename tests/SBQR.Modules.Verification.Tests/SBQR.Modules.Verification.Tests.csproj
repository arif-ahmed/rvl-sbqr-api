<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SBQR.Modules.Verification.Tests — placeholder for epic-8.

    Real tests for the QR-validation handler, the trust-store key
    lookup, and the ISignatureVerifier call land in epic-8.

    Verification is split into one project per Clean Architecture layer.
    The smoke test instantiates the VerificationModule composition root
    (still in the Api project) to verify Name + ApplicationPartAssembly.
  -->

  <PropertyGroup>
    <RootNamespace>SBQR.Modules.Verification.Tests</RootNamespace>
    <AssemblyName>SBQR.Modules.Verification.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharedKernel\SBQR.SharedKernel\SBQR.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Modules\Verification\SBQR.Modules.Verification.Api\SBQR.Modules.Verification.Api.csproj" />
    <ProjectReference Include="..\SBQR.Tests.Common\SBQR.Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

</Project>
