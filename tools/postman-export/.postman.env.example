# =============================================================================
# tools/postman-export/.postman.env.example — tracked template for Postman-export overrides.
#
# Copy to tools/postman-export/.postman.env (gitignored) and edit if you want
# non-default values. Anything you leave out falls back to the hard-coded
# defaults baked into tools/postman-export/Generate-Postman-Export.ps1 and
# tools/postman-export/generate-postman-export.sh.
#
# These are the base URLs that get baked into the generated Postman
# environment files (BQR-Local / BQR-Dev / BQR-Stage / BQR-Prod). They are
# NOT secrets — they are deployment endpoints already published in DNS and
# load balancers.
#
# Loader rules (both scripts):
#   1. If tools/postman-export/.postman.env exists, KEY=VALUE lines are applied
#      on top of the built-in defaults below.
#   2. If tools/postman-export/.postman.env does NOT exist, the built-in
#      defaults apply unchanged. The script does NOT fail when the file is
#      missing.
#   3. Comments (#) and blank lines are ignored. Quoted values are unquoted.
#      No variable expansion / no escape sequences — keep it POSIX-shell simple.
# =============================================================================

# Local API (developer machine). The export generator expects the API on
# http://localhost:5001 when run with -SkipStartup $false.
POSTMAN_LOCAL_BASE_URL=http://localhost:5001

# Dev cluster (shared dev box).
POSTMAN_DEV_BASE_URL=http://localhost:5080

# Stage / pre-prod cluster.
POSTMAN_STAGE_BASE_URL=https://stage.bqr.internal

# Production cluster.
POSTMAN_PROD_BASE_URL=https://api.bqr.example.com
