# =============================================================================
# docker/.env.example — tracked template for LOCAL-DEV overrides.
#
# Copy to docker/.env (gitignored) and edit if you want non-default values.
# Anything you leave out falls back to the docker-compose.yml defaults baked
# into the file (look for the ${VAR:-default} syntax).
#
# Important: this file is for the local docker-compose stack ONLY. Connection
# strings for staging and production live in Azure Key Vault and are injected
# by the orchestrator — see docs/docker/DEPLOYMENT.md.
# =============================================================================

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Host port mapping (container stays on 5432). 5432 means "use what the OS gives
# you" only if you also remove the ports: line from docker-compose.yml.
POSTGRES_HOST_PORT=5432

# --- SBQR.Api ------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
Kestrel__Endpoints__Http__Url=http://+:8080
SBQR_API_HOST_PORT=8080

# Canonical env-var keys used in staging + production too. Override these ONLY
# for local experiments; the real keys must come from Key Vault in upper envs.
ConnectionStrings__sbqr_app=Host=sbqr.postgres;Port=5432;Database=sbqr_app;Username=postgres;Password=postgres
ConnectionStrings__sbqr_key_vault=Host=sbqr.postgres;Port=5432;Database=sbqr_key_vault;Username=postgres;Password=postgres

KeyCustody__ActiveProvider=PlainFile

# --- BB trust store -------------------------------------------------------------
# REQUIRED: the host refuses to start without TrustStore__BaseUrl. Point it at
# the trust store you test against (e.g. an ephemeral mock you run yourself).
TrustStore__BaseUrl=

# Dev-only trust-directory cadence: sync once at boot, then every minute.
# Leave unset/true locally; upper environments never set these.
TrustStore__SyncOnStartup=true
TrustStore__SyncIntervalMinutes=1

# --- OAuth2 client-credentials (POST /v1/oauth/token) ----------------------------
# Dev-only HS256 signing key (32+ chars). Production reads it from Key Vault.
Jwt__Issuer=sbqr
Jwt__Audience=sbqr-api
Jwt__SigningKey=dev-only-signing-key-change-me-0123456789abcdef
Jwt__AccessTokenTtlMinutes=10
# Platform bootstrap client ("client zero" — obtains the admin-scoped token
# for POST /v1/admin/tenants). The API accepts ONLY the Argon2id PHC hash —
# plaintext ClientSecret support was removed from the code. Generate a pair
# with: dotnet run --project src/Host/SBQR.Api -- --generate-bootstrap-secret
# Keep the printed client_secret in your notes (Postman etc) and put the PHC
# here. IMPORTANT: compose interpolates $ in .env values — escape every $ in
# the PHC as $$ or the hash reaches the container mangled
# ($argon2id$v=19$m=65536,... -> $$argon2id$$v=19$$m=65536,...).
Auth__Bootstrap__ClientId=platform-bootstrap
Auth__Bootstrap__ClientSecretHash=$$argon2id$$v=19$$m=65536,t=3,p=1$$REPLACE_ME_WITH_GENERATED_PHC

# --- S3 object storage (real AWS bucket) ----------------------------------------
# The bucket already exists in AWS — this is NOT an emulator. NEVER put real
# values for the two credential lines in this tracked .env.example file;
# set them only in your own gitignored docker/.env.
Storage__ServiceUrl=
Storage__AccessKeyId=
Storage__SecretAccessKey=
Storage__Region=us-east-1
Storage__BucketName=
# Namespaces every object this stack writes under a folder in the shared
# bucket. Suggested: keycustody/<your-name>, so developers running the
# stack concurrently never overwrite each other's dev signing keys.
Storage__VaultFolder=keycustody
# Real AWS S3 uses virtual-hosted addressing; leave false unless ServiceUrl
# above points at an S3-compatible emulator.
Storage__ForcePathStyle=false

# --- Adminer -------------------------------------------------------------------
ADMINER_HOST_PORT=8081
