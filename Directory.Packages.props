<Project>

  <!--
    SBQR.Service — central package versions.

    This is the single source of truth for every NuGet dependency in the
    solution. Individual csproj files MUST use PackageReference without a
    Version attribute; Central Package Management (CPM) is enforced via
    Directory.Build.props.

    Pin every dependency used anywhere in the solution here, even if it is
    referenced by only one project. This makes upgrade review atomic.

    Swashbuckle is intentionally NOT included — see tactical-design.md §8
    (native Microsoft.AspNetCore.OpenApi only).
  -->

  <PropertyGroup>
    <!--
      Central Package Transitive Pinning (CPTP): enables pinning transitive
      package versions from this single file. Required so we can override
      a vulnerable transitive like Microsoft.OpenApi 2.0.0 (pulled in via
      Microsoft.AspNetCore.OpenApi 10.0.0) to the patched 2.4.0.
    -->
    <CentralPackageTransitivePackageVersionsEnabled>true</CentralPackageTransitivePackageVersionsEnabled>
  </PropertyGroup>

  <ItemGroup>

    <!-- ASP.NET Core / OpenAPI (runtime + host) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi"                       Version="10.0.0" />
    <PackageVersion Include="Microsoft.OpenApi"                                 Version="2.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer"      Version="10.0.0" />

    <!-- Asp.Versioning — URL-segment API versioning (v{version:apiVersion}).
         Abstractions is referenced by the module Api projects for [ApiVersion];
         Mvc + Mvc.ApiExplorer are referenced by the host, which owns the
         versioning pipeline and its OpenAPI interop. -->
    <PackageVersion Include="Asp.Versioning.Abstractions"                  Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.Mvc"                                Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer"                    Version="10.2.1" />

    <!-- Scalar.AspNetCore — OpenAPI documentation UI for the two documents
         (v1.public, v1.internal-admin). Chosen over Swashbuckle.AspNetCore
         for the UI layer too, consistent with the native
         Microsoft.AspNetCore.OpenApi document-generation choice above. -->
    <PackageVersion Include="Scalar.AspNetCore"                                 Version="2.17.2" />

    <!-- JWT creation (validation comes with JwtBearer). Used by Tenancy's
         JwtAccessTokenIssuer to mint OAuth2 client-credentials access tokens
         signed with the symmetric Jwt:SigningKey. Issuer == validator for MVP,
         so no JWKS/OIDC-metadata dependency is required. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens"             Version="8.12.0" />

    <!-- Entity Framework Core + Npgsql provider -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore"                      Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational"           Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design"               Version="10.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL"             Version="10.0.0" />

    <!-- MCP server SDK — powers tools/postgres-mcp, the local PostgreSQL
         inspection MCP server used by coding agents. Server-only tool;
         not referenced by any src/ project. -->
    <PackageVersion Include="ModelContextProtocol"                      Version="2.2.0" />

    <!-- Dapper (escape hatch for reporting / ad-hoc SQL) -->
    <PackageVersion Include="Dapper"                                            Version="2.1.66" />

    <!-- MediatR (in-process request/response + cross-module calls) -->
    <PackageVersion Include="MediatR"                                          Version="12.4.1" />
    <!-- MediatR.Contracts is the marker-only package; SharedKernel depends on it instead of full MediatR -->
    <PackageVersion Include="MediatR.Contracts"                               Version="2.0.1" />

    <!-- FluentValidation (input rules per command/query) -->
    <PackageVersion Include="FluentValidation"                                  Version="11.10.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions"    Version="11.10.0" />

    <!-- AutoMapper (Domain -> Application DTO mapping). Pinned to 15.x for current CVE posture;
         bump as needed if a newer major lands before epic-1. -->
    <PackageVersion Include="AutoMapper"                                       Version="15.0.0" />

    <!-- Cryptography — KeyCustody (NSec primary, BouncyCastle cross-impl test
         reference). Bumped to 2.7.0: Testcontainers (LocalStack S3 test
         fixture) pulls in SSH.NET >= 2.7.0 transitively, and CPM treats a
         downgrade as an error. -->
    <PackageVersion Include="NSec.Cryptography"                                Version="25.4.0" />
    <PackageVersion Include="BouncyCastle.Cryptography"                        Version="2.7.0" />

    <!-- Argon2id — used by Tenancy's ISecretHasher to emit the PHC-format
         $argon2id$v=19$m=…,t=…,p=… hash mandated by
         docs/design/database-design.md §1.3 for api_credentials.client_secret_hash. -->
    <PackageVersion Include="Isopoh.Cryptography.Argon2"                       Version="2.0.0" />

    <!-- DPAPI wrapper used by Tenancy's OsKeystoreLocalKeyVault on Windows.
         Provides System.Security.Cryptography.ProtectedData.Protect/Unprotect
         with CurrentUser scope. On non-Windows hosts the vault throws
         PlatformNotSupportedException at startup. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData"      Version="9.0.0" />

    <!-- Polly (cross-module retry / circuit-breaker) -->
    <PackageVersion Include="Polly"                                            Version="8.5.2" />

    <!-- Microsoft.Extensions.* (configuration, hosting, logging, dependency-injection) -->
    <PackageVersion Include="Microsoft.Extensions.Hosting"                     Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration"               Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions"  Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder"        Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json"          Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection"         Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging"                     Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions"        Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options"                     Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageVersion Include="System.Net.Http.Json"                             Version="10.0.0" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk"                            Version="17.11.1" />
    <PackageVersion Include="xunit"                                            Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio"                        Version="2.8.2" />
    <PackageVersion Include="xunit.assert"                                     Version="2.9.2" />
    <PackageVersion Include="NSubstitute"                                      Version="5.1.0" />
    <PackageVersion Include="FluentAssertions"                                 Version="6.12.2" />
    <PackageVersion Include="AutoFixture"                                      Version="4.18.1" />
    <PackageVersion Include="AutoFixture.Xunit2"                               Version="4.18.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing"                 Version="10.0.0" />
    <!-- Test-only infrastructure: Testcontainers spins up ephemeral PG (and,
         via the bare Testcontainers package, an ephemeral LocalStack S3
         container for the KeyCustody S3 tests) per test run; Respawn is an
         FK-safe DELETE-only reset between tests; the bare Npgsql package is
         referenced directly for raw schema-query code in the schema-vs-model
         drift test. None of these are referenced by production code. -->
    <PackageVersion Include="Testcontainers.PostgreSql"                        Version="4.14.0" />
    <PackageVersion Include="Testcontainers"                                   Version="4.14.0" />
    <PackageVersion Include="Respawn"                                          Version="6.2.1" />
    <PackageVersion Include="Npgsql"                                           Version="10.0.0" />
    <!--
      System.Drawing.Common is a transitive dep of Testcontainers.PostgreSql
      (image-compare wait strategies). 5.0.0 has CVE-2021-24112
      (GHSA-rxg9-xrhp-64gj); pinned to the patched 5.0.3 here. The dep is
      only resolved by the test project but the central pin keeps the audit
      advisory clean for the whole solution.
    -->
    <PackageVersion Include="System.Drawing.Common"                           Version="5.0.3" />

    <!-- Architecture tests — enforces module-boundary guardrails in machine-checkable form -->
    <PackageVersion Include="NetArchTest.Rules"                                Version="1.3.2" />

    <!--
      AWSSDK.S3 — backs the S3 object-storage adapter
      (src/SharedKernel/SBQR.SharedKernel.Storage/S3/S3ObjectStorage.cs),
      reused by the KeyCustody S3 key vault. Points at a real AWS bucket in
      local dev and production alike (see docs/dev-s3-guide.md); test
      projects point it at an ephemeral LocalStack container instead.
    -->
    <PackageVersion Include="AWSSDK.S3"                                        Version="4.0.102.5" />

    <!--
      Aspire.Hosting.PostgreSQL — powers src/Host/SBQR.AppHost, a LOCAL
      DEVELOPMENT ONLY orchestrator (dotnet run inner loop). Not referenced
      by any shipped project; docker/docker-compose.yml remains the
      CI/prod-parity path. See docs/aspire-local-dev-guide.md.
      (Aspire.AppHost.Sdk itself is pinned via the SBQR.AppHost.csproj Sdk
      attribute, not here — it's an MSBuild SDK import, not a PackageReference.)
    -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL"                        Version="13.5.4" />

  </ItemGroup>

</Project>
