{
  "openapi": "3.0.4",
  "info": {
    "title": "SBQR.Api | v1.public",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/oauth/token": {
      "post": {
        "tags": [
          "OAuth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/qr/generate/static": {
      "post": {
        "tags": [
          "QrGeneration"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateStaticQrRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateStaticQrRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/GenerateStaticQrRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateQrResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/qr/generate/dynamic": {
      "post": {
        "tags": [
          "QrGeneration"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateDynamicQrRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateDynamicQrRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/GenerateDynamicQrRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateQrResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/qr/validate": {
      "post": {
        "tags": [
          "QrValidation"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateQrRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateQrRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/ValidateQrRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateQrResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "SBQR.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "SBQR.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "SBQR.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GenerateDynamicQrRequest": {
        "required": [
          "transactionAmount",
          "recipientName",
          "recipientCity",
          "recipientPan"
        ],
        "type": "object",
        "properties": {
          "transactionAmount": {
            "type": "string"
          },
          "recipientName": {
            "type": "string"
          },
          "recipientCity": {
            "type": "string"
          },
          "recipientPan": {
            "type": "string"
          },
          "postalCode": {
            "type": "string",
            "nullable": true
          },
          "customerLabel": {
            "type": "string",
            "nullable": true
          },
          "purposeOfTransaction": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "GenerateQrResponse": {
        "required": [
          "qrPayload",
          "payloadHash",
          "qrType",
          "signatureKeyVersion"
        ],
        "type": "object",
        "properties": {
          "qrPayload": {
            "type": "string"
          },
          "payloadHash": {
            "type": "string"
          },
          "qrType": {
            "type": "string"
          },
          "signatureKeyVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          }
        }
      },
      "GenerateStaticQrRequest": {
        "required": [
          "recipientName",
          "recipientCity",
          "recipientPan"
        ],
        "type": "object",
        "properties": {
          "recipientName": {
            "type": "string"
          },
          "recipientCity": {
            "type": "string"
          },
          "recipientPan": {
            "type": "string"
          },
          "postalCode": {
            "type": "string",
            "nullable": true
          },
          "customerLabel": {
            "type": "string",
            "nullable": true
          },
          "purposeOfTransaction": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "OAuthErrorResponse": {
        "required": [
          "error"
        ],
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "TokenResponse": {
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresIn": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          }
        }
      },
      "ValidateQrRequest": {
        "required": [
          "qrPayload"
        ],
        "type": "object",
        "properties": {
          "qrPayload": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "nullable": true
          },
          "requestTimestamp": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ValidateQrResponse": {
        "required": [
          "verdict",
          "trustSource",
          "reasonCode",
          "institutionCode",
          "payloadHash",
          "recipientName",
          "recipientPan",
          "qrClassification"
        ],
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string"
          },
          "trustSource": {
            "type": "string",
            "nullable": true
          },
          "reasonCode": {
            "type": "string",
            "nullable": true
          },
          "institutionCode": {
            "type": "string",
            "nullable": true
          },
          "payloadHash": {
            "type": "string"
          },
          "recipientName": {
            "type": "string",
            "nullable": true
          },
          "recipientPan": {
            "type": "string",
            "nullable": true
          },
          "qrClassification": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "OAuth"
    },
    {
      "name": "QrGeneration"
    },
    {
      "name": "QrValidation"
    },
    {
      "name": "SBQR.Api"
    }
  ]
}
