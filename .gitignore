# Local environment / secrets
.env
.env.*
# Tracked template exception — see .env.example at the repo root (the real
# values live in the gitignored .env, loaded by SBQR.Api in Development only).
!.env.example
# Tracked template exception — see docker/.env.example (the secret lives in
# docker/.env which is gitignored by the rules above).
!docker/.env.example
# Tracked template exception — see tools/postman-export/.postman.env.example
# (the actual values live in tools/postman-export/.postman.env which is
# gitignored by the rules above).
!tools/postman-export/.postman.env.example
appsettings.*.local.json
*.local.json
local.settings.json

# -----------------------------------------------------------------------------
# SBQR.Service-specific ignores
# -----------------------------------------------------------------------------

# Per-user user-secrets (NEVER commit per PUKU.md §11)
# This is the default location used by `dotnet user-secrets`. Each developer
# gets a separate secrets.json file at:
#   Windows: %APPDATA%\Microsoft\UserSecrets\<guid>\secrets.json
#   macOS/Linux: ~/.microsoft/usersecrets/<guid>/secrets.json
# The guid comes from each *.Api.csproj <UserSecretsId> property.
secrets.json
*.secrets.json
**/secrets.json

# Connection strings / signing keys accidentally dropped into appsettings
# (single-file convention: appsettings.json is the ONLY settings file and it
# never carries secrets — env-specific values come from env vars or
# user-secrets. These generic patterns are a safety net against a developer
# dropping a secrets-bearing override file next to the host.)
appsettings.*.local.json
appsettings.*.secrets.json

# -----------------------------------------------------------------------------
# DPAPI / HSM keystores (Windows-only; cert mgmt uses DPAPI at-rest)
# -----------------------------------------------------------------------------
*.dpapi
*.dpapi.xml
*.hsm-ref
*.key-blob
*.blob
keystore/
**/keystore/

# -----------------------------------------------------------------------------
# Generated artifacts
# -----------------------------------------------------------------------------

# Swagger / OpenAPI generated clients (we hand-write the controllers)
swagger.json
swagger.v1.json

# EF Core migrations are SQL-only (PUKU.md §10) — but if anyone ever runs
# `dotnet ef migrations add` locally, ignore the generated artifacts.
**/Migrations/*.cs
!shared/SBQR.Shared.Domain/**/Migrations/*.cs

# OpenTelemetry / Serilog local sinks
*.otlp
*.seq

