<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SBQR.Modules.InstitutionTrust.Infrastructure — EF Core persistence over
    institution_registries / institution_keys. Schema is owned by
    db/migrations/*.sql — this context NEVER calls Database.Migrate().

    Infrastructure depends on Domain (and SharedKernel) only. Handlers live
    in Application and are wired into the composition root by the Api
    layer; this project intentionally does NOT reference Application to
    avoid a circular dependency.
  -->

  <PropertyGroup>
    <RootNamespace>SBQR.Modules.InstitutionTrust.Infrastructure</RootNamespace>
    <AssemblyName>SBQR.Modules.InstitutionTrust.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SBQR.Modules.InstitutionTrust.Domain\SBQR.Modules.InstitutionTrust.Domain.csproj" />
    <ProjectReference Include="..\..\..\SharedKernel\SBQR.SharedKernel\SBQR.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
