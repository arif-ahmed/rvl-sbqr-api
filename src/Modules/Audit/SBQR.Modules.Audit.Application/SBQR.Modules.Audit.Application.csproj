  -->

  <PropertyGroup>
    <RootNamespace>SBQR.Modules.Audit.Application</RootNamespace>
    <AssemblyName>SBQR.Modules.Audit.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
