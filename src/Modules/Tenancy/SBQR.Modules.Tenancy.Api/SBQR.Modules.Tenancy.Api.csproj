<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SBQR.Modules.Tenancy.Api — composition root + HTTP surface. Hosts
    TenancyModule (IModule) and, from Story 6/7 onward, the admin +
    oauth/token controllers. Referenced directly by SBQR.Api; Domain,
    Application, and Infrastructure flow in transitively via
    ProjectReference. See ../README.md.
  -->

  <PropertyGroup>
    <RootNamespace>SBQR.Modules.Tenancy.Api</RootNamespace>
    <AssemblyName>SBQR.Modules.Tenancy.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ASP.NET Core framework reference. Without this the API project cannot
      compile controller / Authorization / OpenAPI types. The actual hosting
      happens in SBQR.Api; this assembly contributes controllers + the
      TenancyModule composition root, and is loaded into the host process
      via ConfigureApplicationPartManager in SBQR.Api/Program.cs.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SBQR.Modules.Tenancy.Application\SBQR.Modules.Tenancy.Application.csproj" />
    <ProjectReference Include="..\SBQR.Modules.Tenancy.Infrastructure\SBQR.Modules.Tenancy.Infrastructure.csproj" />
    <!--
      Explicit (not transitive) so the ITenantAdmissionDirectory seam registered
      below is a first-class dependency of the composition root.
    -->
    <ProjectReference Include="..\SBQR.Modules.Tenancy.Contracts\SBQR.Modules.Tenancy.Contracts.csproj" />
    <ProjectReference Include="..\..\..\SharedKernel\SBQR.SharedKernel\SBQR.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [ApiVersion] attribute for URL-segment API versioning; the versioning
         pipeline itself is owned by the host (SBQR.Api Program.cs §7c). -->
    <PackageReference Include="Asp.Versioning.Abstractions" />
  </ItemGroup>

</Project>
