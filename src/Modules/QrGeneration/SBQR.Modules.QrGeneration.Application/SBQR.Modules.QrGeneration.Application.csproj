<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SBQR.Modules.QrGeneration.Application — orchestration layer. MediatR
    commands, FluentValidation validators. The QR-generation pipeline
    (resolve tenant → activation gate → build → sign → finalize → persist
    → audit) lives here.

    Within-module references: Application → Infrastructure is allowed for
    the DbContext-backed handlers. The cross-module rule that forbids
    Application → OTHER-module's Infrastructure (architecture test
    Modules_should_not_reference_other_modules_Domain_or_Infrastructure)
    is unchanged.
  -->

  <PropertyGroup>
    <RootNamespace>SBQR.Modules.QrGeneration.Application</RootNamespace>
    <AssemblyName>SBQR.Modules.QrGeneration.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SBQR.Modules.QrGeneration.Domain\SBQR.Modules.QrGeneration.Domain.csproj" />
    <ProjectReference Include="..\SBQR.Modules.QrGeneration.Contracts\SBQR.Modules.QrGeneration.Contracts.csproj" />
    <ProjectReference Include="..\SBQR.Modules.QrGeneration.Infrastructure\SBQR.Modules.QrGeneration.Infrastructure.csproj" />
    <ProjectReference Include="..\..\KeyCustody\SBQR.Modules.KeyCustody.Contracts\SBQR.Modules.KeyCustody.Contracts.csproj" />
    <ProjectReference Include="..\..\Tenancy\SBQR.Modules.Tenancy.Contracts\SBQR.Modules.Tenancy.Contracts.csproj" />
    <ProjectReference Include="..\..\..\SharedKernel\SBQR.SharedKernel\SBQR.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!--
    EF Core / Npgsql are referenced from Application because the
    generation-row insert goes through the DbContext directly in the
    handler (the simplest path that matches the Sep-17 inline-save pattern).
    The exception is contained: the architecture test forbids Application →
    OTHER-module's Infrastructure, not Application → own Infrastructure.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
