<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SBQR.Modules.KeyCustody.Application — orchestration layer. Hosts the
    MediatR handlers for the cross-module queries defined in
    SBQR.Modules.KeyCustody.Contracts (e.g. GetSigningKeyQueryHandler).

    Within-module references: Application → Infrastructure is allowed for
    the DbContext-backed handlers. The cross-module rule that forbids
    Application → OTHER-module's Infrastructure (architecture test
    Modules_should_not_reference_other_modules_Domain_or_Infrastructure)
    is unchanged.
  -->

  <PropertyGroup>
    <RootNamespace>SBQR.Modules.KeyCustody.Application</RootNamespace>
    <AssemblyName>SBQR.Modules.KeyCustody.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SBQR.Modules.KeyCustody.Domain\SBQR.Modules.KeyCustody.Domain.csproj" />
    <ProjectReference Include="..\SBQR.Modules.KeyCustody.Contracts\SBQR.Modules.KeyCustody.Contracts.csproj" />
    <ProjectReference Include="..\SBQR.Modules.KeyCustody.Infrastructure\SBQR.Modules.KeyCustody.Infrastructure.csproj" />
    <!--
      Tenancy.Contracts only (never Tenancy.Domain/Infrastructure) — used by
      GenerateOrAdoptCryptoKeyCommandHandler to confirm a tenant exists via
      ITenantDirectory before minting a key. Same cross-module pattern as
      QrGeneration/Verification consuming KeyCustody.Contracts.

      InstitutionTrust.Contracts only — used by GenerateOrAdoptCryptoKeyCommandHandler
      to auto-publish the freshly minted public key into the trust directory
      (IInstitutionTrustPublisher). Same Contracts-only seam as Tenancy above;
      the architecture test forbids Application → other-module's Infrastructure.
    -->
    <ProjectReference Include="..\..\Tenancy\SBQR.Modules.Tenancy.Contracts\SBQR.Modules.Tenancy.Contracts.csproj" />
    <ProjectReference Include="..\..\InstitutionTrust\SBQR.Modules.InstitutionTrust.Contracts\SBQR.Modules.InstitutionTrust.Contracts.csproj" />
    <ProjectReference Include="..\..\..\SharedKernel\SBQR.SharedKernel\SBQR.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!--
    EF Core is referenced from Application because the crypto_keys
    read-model query goes through the DbContext directly in the handler
    (the simplest path that matches the Sep-17 inline-save pattern). The
    exception is contained: the architecture test forbids Application →
    OTHER-module's Infrastructure, not Application → own Infrastructure.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

</Project>
